{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/cron/fetch-news",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 1 * * 1"
    }
  ]
}
